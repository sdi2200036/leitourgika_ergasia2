+#define __NR_sched_assign_processes_to_group 468
+
+int main(int argc, char *argv[])
+{
+	int groupNum, ret;
+	pid_t pid;
+
+	if (argc != 3) {
+		fprintf(stderr, "%s: <pid> <group>\n", *argv);
